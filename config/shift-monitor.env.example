# Copy this file to the platform-specific location described in README.md.
PLC_IP=192.168.88.5
PLC_PORT=502
SHIFT_REGISTER=15
# Current shift plus four previous shifts.
SHIFT_REGISTER_COUNT=5

RTSP_URL=rtsp://127.0.0.1:8554/shift-count
FRAME_WIDTH=854
FRAME_HEIGHT=480
FRAME_RATE=2
# Send a keyframe this often so newly connected viewers start quickly.
KEYFRAME_INTERVAL=2

PLC_POLL_INTERVAL=0.5
PLC_CONNECT_TIMEOUT=2
PLC_RECONNECT_DELAY=2
FFMPEG_PATH=ffmpeg
LOG_LEVEL=INFO

# Set to true only for offsite testing without a PLC.
MOCK_PLC=true
MOCK_CYCLE_SECONDS=2
MOCK_SHIFT_LENGTH=100
