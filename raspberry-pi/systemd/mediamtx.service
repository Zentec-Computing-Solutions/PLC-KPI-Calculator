[Unit]
Description=MediaMTX RTSP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plc-kpi
Group=plc-kpi
EnvironmentFile=-/etc/plc-kpi/service-alert.env
ExecStart=/usr/local/bin/mediamtx /etc/plc-kpi/mediamtx.yml
ExecStopPost=/opt/plc-kpi/notify-service-failure.sh %n ${SERVICE_RESULT}
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
